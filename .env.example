# ── NEXORALABS environment template ──
# Copy this file to `.env` and fill in your values.
# NEVER commit your real .env file.

# Prisma / SQLite
DATABASE_URL=file:./db/custom.db

# NextAuth (generate a strong random string, e.g. `openssl rand -base64 32`)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# Socket.io HMAC token signing secret (generate a strong random string)
SOCKET_SECRET=replace-with-another-strong-random-secret

# Public base URL (used in email links)
APP_BASE_URL=http://localhost:3000

# Resend email service — paste YOUR own API key here.
# When left empty, emails are logged to the server console and verification
# links are returned in the API response so all flows still work end-to-end.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NEXORALABS <no-reply@nexoralabs.com>
