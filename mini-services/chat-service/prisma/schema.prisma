// NEXORALABS — company platform data model
//
// This schema works with PostgreSQL (Aiven prod). All tables/enums are prefixed
// with nexora_ via @@map so they coexist with other projects on the same DB.
// To switch to SQLite (local dev): change provider to "sqlite" and remove the
// @@map directives (or keep them — SQLite ignores table-name casing).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ── LOCAL DEV (SQLite) ──
  // provider = "sqlite"
  // ── AIVEN POSTGRES ──
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users ─────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  @@map("nexora_role")
}

// PENDING    — registered via invite, email verified, awaiting admin approval
// ACTIVE     — approved & in good standing
// SUSPENDED  — temporarily disabled by an admin
// REJECTED   — rejected; the record is removed so the email can re-register
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  @@map("nexora_user_status")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  password      String? // credentials login (null only for OAuth — not used here)
  image         String?
  role          Role       @default(EMPLOYEE)
  status        UserStatus @default(PENDING)

  // verification & approval lifecycle
  emailVerified DateTime?
  verifyToken        String?
  verifyTokenExpiry  DateTime?
  approvedBy    String? // admin user id
  approvedAt    DateTime?
  rejectedAt    DateTime?
  rejectedReason String?

  // password reset (forgot-password flow)
  passwordResetToken       String?
  passwordResetTokenExpiry DateTime?
  passwordChangedAt        DateTime?

  // profile
  title       String? // job title
  department  String?
  phone       String?
  bio         String?
  location    String?

  // tracking
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // relationships
  inviteLinkId String?
  inviteLink   InviteLink? @relation("InviteRegistrations", fields: [inviteLinkId], references: [id])
  chats        ChatMember[]
  messages     Message[]
  createdChats Chat[]       @relation("ChatCreator")
  inviteLinks  InviteLink[] @relation("InviteCreator")
  announcements Announcement[]
  activityLogs ActivityLog[]
  notifications Notification[]
  pipelineItems PipelineItem[] @relation("PipelineCreator")
  comments       Comment[]      @relation("CommentCreator")

  @@index([status])
  @@index([role])
  @@map("nexora_users")
}

// ───────────────────────── Waitlist ─────────────────────────
// Waitlist entries are NOT users. They are prospective customers.

enum WaitlistStatus {
  PENDING_VERIFICATION
  CONFIRMED
  CONTACTED
  @@map("nexora_waitlist_status")
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  company   String?
  role      String? // job role of the prospect
  interest  String? // what they want from NEXORALABS
  message   String?
  status    WaitlistStatus @default(PENDING_VERIFICATION)
  // Legacy link-based verification (kept for backward compat)
  verifyToken      String?
  verifyTokenExpiry DateTime?
  // OTP-based verification (preferred flow)
  otp         String?
  otpExpiry   DateTime?
  otpAttempts Int      @default(0)
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("nexora_waitlist")
}

// ───────────────────────── Invite links ─────────────────────────
// Admins generate these and share privately. Registration is gated by
// a correct token AND (maxUses, expiresAt, active) — a link is only
// "expired" when expiresAt passes OR currentUses >= maxUses or active=false.

model InviteLink {
  id          String   @id @default(cuid())
  token       String   @unique
  label       String? // friendly note from creator
  createdBy   String
  creator     User     @relation("InviteCreator", fields: [createdBy], references: [id])
  maxUses     Int      @default(1)
  currentUses Int      @default(0)
  expiresAt   DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]     @relation("InviteRegistrations")

  @@index([createdBy])
  @@map("nexora_invite_links")
}

// ───────────────────────── Chats / Messaging ─────────────────────────
// No client-side encryption. The backend is hardened: membership-scoped
// queries, signed socket tokens, TLS via gateway. MITM mitigated server-side.

enum ChatType {
  DIRECT
  GROUP
  @@map("nexora_chat_type")
}

enum ChatMemberRole {
  ADMIN // group admin (manages members)
  MEMBER
  @@map("nexora_chat_member_role")
}

model Chat {
  id          String   @id @default(cuid())
  type        ChatType
  name        String? // group name (null for direct)
  description String?
  avatar      String?
  createdBy   String
  creator     User     @relation("ChatCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ChatMember[]
  messages    Message[]

  @@index([type])
  @@map("nexora_chats")
}

model ChatMember {
  id      String        @id @default(cuid())
  chatId  String
  userId  String
  role    ChatMemberRole @default(MEMBER)
  joinedAt DateTime      @default(now())
  lastReadAt DateTime?

  chat    Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@map("nexora_chat_members")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  deletedAt DateTime? // soft delete (user removed their message)

  chat      Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
  @@map("nexora_messages")
}

// ───────────────────────── Announcements ─────────────────────────

enum AnnouncementCategory {
  NEWS
  UPDATE
  EVENT
  PARTNERSHIP
  ACHIEVEMENT
  @@map("nexora_announcement_category")
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  summary    String
  content    String
  category   AnnouncementCategory @default(NEWS)
  imageUrl   String?
  published  Boolean  @default(false)
  publishedAt DateTime?
  pinned     Boolean  @default(false)
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
  @@map("nexora_announcements")
}

// ───────────────────────── Activity log ─────────────────────────
// Row-level scoping: entries are visible to the owner and to admins only.

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String? // null = system
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String // JSON string
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("nexora_activity_logs")
}

// ───────────────────────── Notifications ─────────────────────────
// In-app notification mirror of emails + general notices.

enum NotificationType {
  LOGIN
  ACCOUNT_CHANGE
  NEW_MESSAGE
  APPROVAL
  WAITLIST_CONFIRM
  SYSTEM
  @@map("nexora_notification_type")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  metadata  String? // JSON
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("nexora_notifications")
}

// ───────────────────────── Innovation Pipeline ─────────────────────────
// Admin-managed list of solution tracks shown on the landing page hero card.

model PipelineItem {
  id          String   @id @default(cuid())
  title       String
  sdgTags     String   // e.g. "SDG 2 · 13"
  progress    Int      @default(0) // 0-100
  iconName    String   @default("Leaf") // lucide icon name
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdBy   String
  creator     User     @relation("PipelineCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("nexora_pipeline_items")
}

// ───────────────────────── Comments / Testimonials ─────────────────────────
// Admin-managed comments/testimonials displayed on the landing page.

model Comment {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String?  // e.g. "Partner Founder"
  authorCompany String?
  content     String
  rating      Int      @default(5) // 1-5
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  createdBy   String
  creator     User     @relation("CommentCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured])
  @@map("nexora_comments")
}
